{
  "name": "app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start",
    "check-types": "tsc --noEmit",
    "test": "jest",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android --dev-client",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "bun ./scripts/build-android.js",
    "build:dev:remote": "eas build --platform android --profile development --non-interactive",
    "build:preview:remote": "eas build --platform android --profile preview --non-interactive",
    "build:prod:remote": "eas build --platform android --profile production --non-interactive",
    "upload:firebase": "bun ./scripts/upload-firebase.js",
    "upload:play": "bun ./scripts/upload-play-store.js",
    "ship:qa": "bun build:android --stag --apk && bun upload:firebase --stag --apk",
    "ship:prod": "bun build:android --prod --aab && bun upload:play --prod"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.7.3",
    "@react-navigation/elements": "^2.8.1",
    "@react-navigation/native": "^7.1.28",
    "expo": "~55.0.0-preview.11",
    "expo-constants": "~55.0.5",
    "expo-dev-client": "~55.0.6",
    "expo-device": "~55.0.7",
    "expo-font": "~55.0.4",
    "expo-glass-effect": "~55.0.6",
    "expo-image": "~55.0.3",
    "expo-linking": "~55.0.4",
    "expo-router": "~55.0.0-preview.8",
    "expo-splash-screen": "~55.0.6",
    "expo-status-bar": "~55.0.3",
    "expo-symbols": "~55.0.4",
    "expo-system-ui": "~55.0.6",
    "expo-web-browser": "~55.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.0",
    "@babel/preset-typescript": "^7.23.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.6",
    "metro-react-native-babel-preset": "^0.77.0",
    "react-test-renderer": "19.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.2"
  },
  "private": true
}
