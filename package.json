{
  "name": "monorepo-ci-cd",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint:check": "bunx biome check",
    "lint:write": "bunx biome check --write",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "turbo": "^2.8.9",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.6",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --no-errors-on-unmatched --error-on-warnings"
    ],
    "*.{json,md,yml,yaml}": [
      "biome format --no-errors-on-unmatched"
    ]
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
